{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LunarMobDefinition",
  "description": "Schema for HaoHanLunar mob definition YAML files",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "config-version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "drop_table": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "options": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
